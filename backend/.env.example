AI_API_KEY=your_universal_ai_api_key_here

# Tùy chọn tương thích ngược:
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Đường dẫn file Firebase Service Account JSON (Tải tại Firebase Console -> Project Settings -> Service Accounts)
