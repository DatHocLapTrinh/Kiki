# Groq AI API Key (Lấy tại https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Đường dẫn file Firebase Service Account JSON (Tải tại Firebase Console -> Project Settings -> Service Accounts)
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# Cổng khởi chạy máy chủ
SERVER_PORT=8080
